# Default authentication method: local username and password.
# Startup fails while local authentication is enabled and this value is empty
# or shorter than 12 characters. Generate a unique password before first use.
ARCHIVE_AUTH_LOCAL_ENABLED=true
ARCHIVE_ADMIN_USERNAME=admin
ARCHIVE_ADMIN_PASSWORD=

# Optional Telegram one-time-code login.
# Create a bot with BotFather, send it a message, then configure the bot token
# and the single chat ID that is allowed to receive archive login codes.
ARCHIVE_TELEGRAM_BOT_TOKEN=
# _FILE requires a site-specific Compose secret or bind mount.
# ARCHIVE_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
ARCHIVE_TELEGRAM_CHAT_ID=

# Optional WhatsApp one-time-code login.
# The generic webhook receives JSON with recipient, message, and purpose.
ARCHIVE_WHATSAPP_WEBHOOK_URL=
ARCHIVE_WHATSAPP_WEBHOOK_TOKEN=
# _FILE requires a site-specific Compose secret or bind mount.
# ARCHIVE_WHATSAPP_WEBHOOK_TOKEN_FILE=/run/secrets/whatsapp_webhook_token
ARCHIVE_WHATSAPP_RECIPIENT=

# Optional runtime settings.
# The secure default exposes the UI only on the Docker host. Set 0.0.0.0 only
# when clients on a trusted LAN or private VPN must connect directly.
ARCHIVE_BIND_ADDRESS=127.0.0.1
ARCHIVE_HTTP_PORT=8088
ARCHIVE_SECURE_COOKIES=false
ARCHIVE_LOG_LEVEL=INFO
ARCHIVE_MAX_RECORDING_GB=20
# Container safety limits. 768m works well for typical small servers and
# Raspberry Pi systems with at least 1 GB RAM; lower only after observing use.
ARCHIVE_MEMORY_LIMIT=768m
ARCHIVE_PIDS_LIMIT=256

# Container filesystem identity. Change these values when a NAS share expects a
# different numeric UID/GID. The default is the unprivileged image user.
ARCHIVE_UID=10001
ARCHIVE_GID=10001

# SQLite inventory, settings, sessions, and the local password hash.
ARCHIVE_DATA_PATH=./data

# The host directory where videos and exports are stored. This is mounted into
# the container at /archive. It may be a local disk or an NFS/SMB-mounted NAS.
ARCHIVE_HOST_PATH=./archive

# This default can later be changed in the web interface.
ARCHIVE_DEFAULT_SUBDIRECTORY=vehicles
TZ=UTC
